{
  "name": "@findme/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Type-safe client for @findme/api generated from its OpenAPI document (openapi-typescript + openapi-fetch).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
