{
  "name": "daily-fate",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "engine:build": "pnpm --filter @fortune/engine build",
    "engine:test": "pnpm --filter @fortune/engine test",
    "mobile": "pnpm engine:build && pnpm --filter mobile start",
    "web": "pnpm engine:build && pnpm --filter mobile web",
    "web:export": "pnpm engine:build && pnpm --filter mobile export:web"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
