# ---- server ----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=*
RATE_LIMIT_MAX=300

# ---- database --------------------------------------------------------------
# unset            → in-memory PGlite (data lost on restart; fine for quick dev & tests)
# pglite:./.data   → persistent PGlite directory (local dev without Postgres)
# postgres://user:pass@host:5432/db → node-postgres (production / Supabase)
#DATABASE_URL=pglite:./.data/pglite
# apply drizzle/rls.sql after migrations on Postgres (ignored on PGlite). default: true
APPLY_RLS=true

# ---- cache / quotas ----------------------------------------------------------
# unset → in-memory store; redis://… → ioredis
#REDIS_URL=redis://localhost:6379

# ---- secrets (generated with a warning in dev when missing; REQUIRED in production) ----
# openssl rand -base64 32
JWT_SECRET=
# openssl rand -base64 32   (AES-256-GCM key for profiles.birth_enc)
BIRTH_ENC_KEY=
GUEST_TOKEN_TTL_DAYS=180

# ---- integrations (optional; the related endpoint returns 501 / skips verification when unset) ----
#SUPABASE_JWT_SECRET=
#REVENUECAT_WEBHOOK_SECRET=
#STRIPE_WEBHOOK_SECRET=whsec_...

# first deep reading per user is free (docs/04 §6). default: true
FREE_FIRST_READING=true
