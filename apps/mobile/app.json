{
  "expo": {
    "name": "Findme",
    "slug": "findme",
    "version": "0.1.0",
    "scheme": "findme",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0B1020",
    "splash": { "backgroundColor": "#0B1020", "resizeMode": "contain" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "vn.findme.app", "infoPlist": { "UIBackgroundModes": ["remote-notification"] } },
    "android": { "package": "vn.findme.app", "adaptiveIcon": { "backgroundColor": "#0B1020" }, "permissions": ["POST_NOTIFICATIONS", "VIBRATE"] },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      ["expo-notifications", { "color": "#E7C56A" }],
      ["expo-splash-screen", { "backgroundColor": "#0B1020" }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "router": {}, "eas": { "projectId": "00000000-0000-0000-0000-000000000000" } }
  }
}
