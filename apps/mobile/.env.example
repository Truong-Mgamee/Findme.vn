# Base URL of @findme/api (no trailing slash). The client appends /v1/...
EXPO_PUBLIC_API_URL=http://localhost:3000
# PostHog project API key — analytics are a no-op when empty
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# CDN serving the Classic 1909 tarot deck as {CDN}/classic-1909/<id>.webp (placeholder cards when empty)
EXPO_PUBLIC_TAROT_CDN=
