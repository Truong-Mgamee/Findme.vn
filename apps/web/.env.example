# Base URL of @findme/api (no trailing slash). Unset → SEO pages render from engines only, /app shows a "not configured" notice.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site origin for canonical/hreflang/sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# /admin login token (compared against the fm_admin cookie) and forwarded to the API as X-Admin-Token.
ADMIN_TOKEN=change-me-at-least-12-chars
# Smart app banner (optional)
NEXT_PUBLIC_IOS_APP_ID=
NEXT_PUBLIC_ANDROID_PACKAGE=vn.findme.app
